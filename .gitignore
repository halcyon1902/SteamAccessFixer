# Backup / temp files do chính script sinh ra
hosts.bak_steam
hosts.steamfix.*.tmp
*.restore.tmp

# PowerShell artifacts
*.ps1xml
*.psc1
*.pssc
*.psd1~
*.psd1.backup
*.ps1~
PSScriptAnalyzer.results.xml

# Logs & test results
*.log
*.trx
[Tt]est[Rr]esult*/

# Build output (phòng khi sau này thêm CI/build)
[Bb]in/
[Oo]bj/
[Oo]ut/

# IDE — VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE — Visual Studio / JetBrains
.vs/
.idea/
_ReSharper*/
*.DotSettings.user

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Temp chung
*.tmp
*~
